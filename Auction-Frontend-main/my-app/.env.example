# Backend API URL (Replace with your deployed backend URL, e.g., https://auction-bazaar-backend.onrender.com)
REACT_APP_API_URL=https://your-backend.onrender.com

# WebSocket URL (Replace with your deployed backend WebSocket URL)
# Note: SockJS uses https://
REACT_APP_WS_URL=https://your-backend.onrender.com/ws
