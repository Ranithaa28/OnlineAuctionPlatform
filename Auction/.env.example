# Port injected automatically by Render/Railway (Defaults to 8080 if not set)
PORT=8080

# Database Configuration
# Cloud MySQL JDBC URL (e.g., from Aiven, Railway, TiDB, or Clever Cloud)
DB_URL=jdbc:mysql://<host>:<port>/<dbname>?useSSL=true&serverTimezone=UTC
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password

# Brevo SMTP Configuration
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=b6590e001@smtp-brevo.com
EMAIL_PASSWORD=your_brevo_smtp_key

# JWT & Admin
JWT_SECRET=your_super_secret_key_at_least_256_bits_long_abcdef1234567890
ADMIN_EMAIL=your_admin_email@example.com
ADMIN_PASSWORD=your_admin_password
